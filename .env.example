# Copy this file to .env and fill in your values

# Django
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# API Keys
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Yoto integration — get credentials from https://dashboard.yoto.dev
YOTO_CLIENT_ID=
YOTO_CLIENT_SECRET=
YOTO_REDIRECT_URI=http://localhost:8000/yoto/callback/
